---
const navigation = [
  { label: 'Home', href: '/' },
  { label: 'Resume', href: '/resume/' },
];
---

<header class="site-chrome border-line/80 bg-paper/90 sticky top-0 z-20 border-b backdrop-blur" data-site-chrome>
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-5 py-4 sm:px-8 md:flex-row md:items-center md:justify-between">
    <a
      class="group inline-flex w-fit flex-col rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      href="/"
      aria-label="sunwjy 홈으로 이동"
    >
      <span class="text-accent text-xs font-semibold uppercase tracking-[0.24em]">SUNWJY</span>
    </a>

    <nav class="flex flex-wrap items-center gap-2" aria-label="주요 페이지">
      {
        navigation.map((item) => (
          <a
            class="border-line inline-flex min-h-10 items-center justify-center rounded-full border bg-white/55 px-4 text-sm font-semibold text-neutral-800 transition hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
