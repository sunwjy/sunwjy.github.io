---
const internalLinks = [
  { label: 'Home', href: '/' },
  { label: 'Resume', href: '/resume/' },
  { label: 'Experience', href: '/experience/' },
];

const contactLinks = [
  { label: 'Email', href: 'mailto:sunwjy00@gmail.com' },
  { label: 'GitHub', href: 'https://github.com/sunwjy' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/sunwjy/' },
];
---

<footer class="site-chrome border-line/80 bg-paper border-t" data-site-chrome>
  <div class="mx-auto grid w-full max-w-7xl gap-8 px-5 py-8 sm:px-8 md:grid-cols-[1fr_auto_auto] md:items-start">
    <div>
      <p class="text-sm text-neutral-600">© 2026 SUNWJY. All rights reserved.</p>
    </div>

    <nav aria-label="사이트 링크">
      <h2 class="text-sm font-semibold text-neutral-900">Navigate</h2>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 md:flex-col">
        {
          internalLinks.map((link) => (
            <li>
              <a class="text-sm text-neutral-700 underline-offset-4 hover:text-accent hover:underline" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="연락 및 외부 링크">
      <h2 class="text-sm font-semibold text-neutral-900">Connect</h2>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 md:flex-col">
        {
          contactLinks.map((link) => (
            <li>
              <a
                class="text-sm text-neutral-700 underline-offset-4 hover:text-accent hover:underline"
                href={link.href}
                rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
