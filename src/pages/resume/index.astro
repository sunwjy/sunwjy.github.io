---

<Layout
  title={`${profile.name} | 이력서`}
  description="웹 서비스 전반을 설계·구현하며 아이디어 단계의 제품을 실제 사용자에게 전달하고, 기술·비즈니스·사용자 관점을 함께 고려해 출시와 운영까지 이어온 풀스택 개발자 이력서입니다."
  type="profile"
>
    <main class="resume-root mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-16 px-5 py-10 sm:px-8 lg:gap-20 lg:py-16">
      <header class="border-line bg-paper/80 rounded-lg border p-6 shadow-sm print:shadow-none sm:p-8">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.72fr)] lg:items-start">
          <div>
            <p class="text-accent text-sm font-semibold uppercase tracking-[0.18em]">
              Resume
            </p>
            <h1 class="mt-5 text-4xl font-semibold leading-tight text-balance sm:text-5xl">
              {profile.name}
            </h1>
            <p class="mt-4 text-xl font-medium text-neutral-800">{profile.role}</p>
            <p class="mt-2 text-sm text-neutral-600">{profile.location}</p>
            <p class="mt-6 max-w-3xl text-lg font-semibold leading-8 text-neutral-900">
              {profile.headline}
            </p>
          </div>

          <div class="space-y-6 text-sm lg:border-l lg:border-line lg:pl-8">
            <a
              class="resume-email-button bg-accent hover:bg-accent-strong inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-semibold text-white transition"
              href={`mailto:${profile.email}`}
            >
              이메일 보내기
            </a>

            <dl class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
              <div>
                <dt class="font-semibold text-neutral-900">Email</dt>
                <dd class="mt-1 text-neutral-700">
                  <a class="underline-offset-4 hover:text-accent hover:underline" href={`mailto:${profile.email}`}>
                    {profile.email}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-neutral-900">Links</dt>
                <dd class="mt-2 flex flex-wrap gap-3 lg:flex-col lg:gap-2">
                  {
                    profile.links.map((link) => (
                      <a
                        class="inline-flex items-center gap-2 text-neutral-700 underline-offset-4 hover:text-accent hover:underline"
                        href={link.href}
                      >
                        <img class="h-4 w-4 object-contain" src={link.icon} alt="" aria-hidden="true" loading="lazy" />
                        <span>{link.label}</span>
                      </a>
                    ))
                  }
                </dd>
              </div>
            </dl>
          </div>
        </div>

        <section class="mt-8 border-t border-line pt-6" aria-labelledby="primary-stack">
          <h2 id="primary-stack" class="text-sm font-semibold text-neutral-900">Primary Stack</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              profile.stack.map((item) => (
                <span class="border-line rounded-md border bg-white/60 px-2.5 py-1.5 text-xs font-medium text-neutral-800">
                  {item}
                </span>
              ))
            }
          </div>
        </section>
      </header>

      <section class="resume-content space-y-16 lg:space-y-20">
        <section aria-labelledby="introduction">
          <h2 id="introduction" class="text-sm font-semibold uppercase tracking-[0.18em] text-neutral-500">
            소개
          </h2>
          <div class="mt-4 space-y-3 leading-8 text-neutral-700">
            {introductions.map((item) => <p>{item}</p>)}
          </div>
        </section>

        <section aria-labelledby="focus">
          <h2 id="focus" class="text-sm font-semibold uppercase tracking-[0.18em] text-neutral-500">
            핵심 경험
          </h2>
          <div class="mt-5 divide-y divide-line border-y border-line">
            {
              focusAreas.map((area) => (
                <article class="grid gap-4 py-6 sm:grid-cols-[14rem_1fr] lg:grid-cols-[16rem_1fr]">
                  <div>
                    <h3 class="text-lg font-semibold leading-7 text-neutral-900">{area.title}</h3>
                  </div>
                  <div>
                    <p class="leading-8 text-neutral-700">{area.description}</p>
                    <ul class="mt-3 list-disc space-y-2 pl-5 text-neutral-700">
                      {area.points.map((point) => <li>{point}</li>)}
                    </ul>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="resume-print-section" aria-labelledby="experience">
          <h2 id="experience" class="text-sm font-semibold uppercase tracking-[0.18em] text-neutral-500">
            경력
          </h2>
          <div class="mt-5 divide-y divide-line border-y border-line">
            {
              experiences.map((experience) => (
                <article class="grid gap-4 py-6 sm:grid-cols-[14rem_1fr] lg:grid-cols-[16rem_1fr]">
                  <div>
                    <h3 class="text-lg font-semibold leading-7 text-neutral-900">{experience.company}</h3>
                    <p class="mt-2 text-sm font-medium text-neutral-600">{experience.period}</p>
                  </div>
                  <div class="space-y-4">
                    <dl class="grid gap-3 text-sm sm:grid-cols-2">
                      <div>
                        <dt class="font-semibold text-neutral-900">포지션</dt>
                        <dd class="mt-1 text-neutral-700">{experience.position}</dd>
                      </div>
                      <div>
                        <dt class="font-semibold text-neutral-900">도메인</dt>
                        <dd class="mt-1 text-neutral-700">{experience.domain}</dd>
                      </div>
                      {experience.note && (
                        <div class="sm:col-span-2">
                          <dt class="font-semibold text-neutral-900">특이사항</dt>
                          <dd class="mt-1 text-neutral-700">{experience.note}</dd>
                        </div>
                      )}
                      <div class="sm:col-span-2">
                        <dt class="font-semibold text-neutral-900">사용기술</dt>
                        <dd class="mt-2 flex flex-wrap gap-2">
                          {experience.technologies.map((technology) => (
                            <span class="rounded-md border border-line bg-white/60 px-2 py-1 text-xs font-medium text-neutral-800">
                              {technology}
                            </span>
                          ))}
                        </dd>
                      </div>
                    </dl>
                    <div>
                      <h4 class="text-sm font-semibold text-neutral-900">담당업무</h4>
                      <ul class="mt-3 list-disc space-y-2 pl-5 text-neutral-700">
                        {experience.responsibilities.map((responsibility) => (
                          <li>{responsibility}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </section>


        <section class="resume-print-section" aria-labelledby="additional-experience">
          <h2 id="additional-experience" class="text-sm font-semibold uppercase tracking-[0.18em] text-neutral-500">
            기타 경력
          </h2>
          <div class="mt-5 divide-y divide-line border-y border-line">
            {
              additionalExperiences.map((experience) => (
                <article class="grid gap-4 py-6 sm:grid-cols-[14rem_1fr] lg:grid-cols-[16rem_1fr]">
                  <div>
                    <h3 class="text-lg font-semibold leading-7 text-neutral-900">{experience.company}</h3>
                    <p class="mt-2 text-sm font-medium text-neutral-600">{experience.period}</p>
                  </div>
                  <div class="space-y-4">
                    <dl class="grid gap-3 text-sm sm:grid-cols-2">
                      <div>
                        <dt class="font-semibold text-neutral-900">구분</dt>
                        <dd class="mt-1 text-neutral-700">{experience.position}</dd>
                      </div>
                      <div>
                        <dt class="font-semibold text-neutral-900">도메인</dt>
                        <dd class="mt-1 text-neutral-700">{experience.domain}</dd>
                      </div>
                      <div class="sm:col-span-2">
                        <dt class="font-semibold text-neutral-900">사용기술</dt>
                        <dd class="mt-2 flex flex-wrap gap-2">
                          {experience.technologies.map((technology) => (
                            <span class="rounded-md border border-line bg-white/60 px-2 py-1 text-xs font-medium text-neutral-800">
                              {technology}
                            </span>
                          ))}
                        </dd>
                      </div>
                    </dl>
                    <div>
                      <h4 class="text-sm font-semibold text-neutral-900">주요 내용</h4>
                      <ul class="mt-3 list-disc space-y-2 pl-5 text-neutral-700">
                        {experience.responsibilities.map((responsibility) => (
                          <li>{responsibility}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="skills">
          <h2 id="skills" class="text-sm font-semibold uppercase tracking-[0.18em] text-neutral-500">
            기술 역량
          </h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            {
              skillGroups.map((group) => (
                <article class="border-line rounded-lg border bg-white/55 p-5">
                  <h3 class="text-lg font-semibold text-neutral-900">{group.category}</h3>
                  <dl class="mt-4 space-y-3">
                    {group.skills.map((skill) => (
                      <div>
                        <dt class="font-semibold text-neutral-900">{skill.name}</dt>
                        <dd class="mt-1 text-sm leading-6 text-neutral-700">{skill.detail}</dd>
                      </div>
                    ))}
                  </dl>
                </article>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="activities">
          <h2 id="activities" class="text-sm font-semibold uppercase tracking-[0.18em] text-neutral-500">
            기타 활동
          </h2>
          <div class="mt-5 divide-y divide-line border-y border-line">
            {
              activities.map((activity) => (
                <article class="grid gap-4 py-6 sm:grid-cols-[14rem_1fr] lg:grid-cols-[16rem_1fr]">
                  <div>
                    <h3 class="text-lg font-semibold leading-7 text-neutral-900">{activity.title}</h3>
                    <p class="mt-2 text-sm font-medium text-neutral-600">{activity.period}</p>
                  </div>
                  <div class="space-y-4">
                    <dl class="grid gap-3 text-sm sm:grid-cols-2">
                      <div class="sm:col-span-2">
                        <dt class="font-semibold text-neutral-900">대상</dt>
                        <dd class="mt-1 text-neutral-700">{activity.target}</dd>
                      </div>
                    </dl>
                    <ul class="list-disc space-y-2 pl-5 text-neutral-700">
                      {activity.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      </section>
    </main>
</Layout>
