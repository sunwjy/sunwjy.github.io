---
import '../../styles/global.css';

const profile = {
  name: 'Jaeyun Woo',
  role: 'Software Engineer',
  location: 'Seoul, Korea',
  email: 'hello@example.com',
  links: [
    { label: 'GitHub', href: 'https://github.com/sunwjy' },
    { label: 'LinkedIn', href: 'https://www.linkedin.com/' },
  ],
};

const highlights = [
  'Builds reliable web products with a strong bias toward simple systems.',
  'Comfortable across frontend architecture, product UX, and delivery automation.',
  'Interested in high-signal interfaces, maintainable codebases, and measurable outcomes.',
];

const experience = [
  {
    company: 'Company Name',
    role: 'Senior Software Engineer',
    period: '2023 - Present',
    points: [
      'Led product-facing frontend architecture for a static-first web experience.',
      'Improved build, lint, and release workflows for faster iteration.',
      'Partnered with design and product teams to turn ambiguous requirements into shipped features.',
    ],
  },
  {
    company: 'Previous Company',
    role: 'Software Engineer',
    period: '2020 - 2023',
    points: [
      'Built reusable UI patterns and content-driven pages with strong accessibility defaults.',
      'Reduced maintenance overhead by simplifying shared components and styling conventions.',
    ],
  },
];

const skills = ['Astro', 'TypeScript', 'Tailwind CSS', 'Design Systems', 'CI/CD', 'Testing'];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{profile.name} | Resume</title>
    <meta
      name="description"
      content={`${profile.name}의 정적 이력서 웹사이트입니다.`}
    />
  </head>
  <body class="font-sans antialiased">
    <main class="mx-auto grid min-h-screen w-full max-w-6xl gap-10 px-5 py-8 sm:px-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14 lg:py-14">
      <aside class="lg:sticky lg:top-14 lg:h-fit">
        <div class="border-line bg-paper/70 rounded-lg border p-6 shadow-sm">
          <p class="text-accent text-sm font-semibold uppercase tracking-[0.18em]">
            Resume
          </p>
          <h1 class="mt-5 text-4xl font-semibold leading-tight text-balance sm:text-5xl">
            {profile.name}
          </h1>
          <p class="mt-4 text-xl text-neutral-700">{profile.role}</p>
          <p class="mt-2 text-sm text-neutral-600">{profile.location}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              class="bg-accent hover:bg-accent-strong inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-semibold text-white transition"
              href={`mailto:${profile.email}`}
            >
              Email
            </a>
          </div>

          <nav class="mt-8 flex flex-col gap-2 text-sm">
            {
              profile.links.map((link) => (
                <a class="text-neutral-700 underline-offset-4 hover:text-accent hover:underline" href={link.href}>
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </aside>

      <section class="space-y-10">
        <section aria-labelledby="summary">
          <h2 id="summary" class="text-sm font-semibold uppercase tracking-[0.18em] text-neutral-500">
            Summary
          </h2>
          <div class="mt-4 space-y-3 text-lg leading-8 text-neutral-800">
            {highlights.map((item) => <p>{item}</p>)}
          </div>
        </section>

        <section aria-labelledby="experience">
          <h2 id="experience" class="text-sm font-semibold uppercase tracking-[0.18em] text-neutral-500">
            Experience
          </h2>
          <div class="mt-5 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
            {
              experience.map((job) => (
                <article class="grid gap-4 py-6 sm:grid-cols-[10rem_1fr]">
                  <div>
                    <p class="font-semibold">{job.period}</p>
                    <p class="mt-1 text-sm text-neutral-600">{job.company}</p>
                  </div>
                  <div>
                    <h3 class="text-xl font-semibold">{job.role}</h3>
                    <ul class="mt-3 list-disc space-y-2 pl-5 text-neutral-700">
                      {job.points.map((point) => <li>{point}</li>)}
                    </ul>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="skills">
          <h2 id="skills" class="text-sm font-semibold uppercase tracking-[0.18em] text-neutral-500">
            Skills
          </h2>
          <div class="mt-5 flex flex-wrap gap-2">
            {
              skills.map((skill) => (
                <span class="border-line rounded-md border bg-white/55 px-3 py-2 text-sm font-medium">
                  {skill}
                </span>
              ))
            }
          </div>
        </section>
      </section>
    </main>
  </body>
</html>
